<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 一覧のUI Automation応答を検査するため。 -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><Using Include="System.IO" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/CapchunScreen/CapchunScreen.csproj" /></ItemGroup>
</Project>
